# Local-only / eyes-only files for the ringlpn subproject.
#
# Note on precedence: the top-level .gitignore whitelists
# `GPU-MPC/ringlpn/results/*.md` and `GPU-MPC/ringlpn/scripts/*.sh`. This file
# re-excludes specific private patterns *within* ringlpn, overriding that
# whitelist for files matching the patterns below. Files already tracked in
# git are NOT affected by .gitignore; use `git rm --cached <path>` to stop
# tracking them (keeps the local copy).

# -- Private drafts and correspondence --
results/email*.md
results/*_draft.md
results/*draft*.md
results/notes*.md
results/TODO*.md
results/*_private.md

# -- Given materials (papers / docx / slides provided to you) --
*.pdf
*.PDF
*.docx
*.DOCX
*.pptx
*.PPTX
papers/
givens/
readings/

# -- Private scratch / notes directories --
private/
notes/
scratch/
.notes/

# -- Build output (host-only artifacts; CUDA bin/ already ignored at top level) --
host_bin/

# -- Regenerable two-party protocol records / keys --
results/dpf/two_party_keys/
results/dpf/two_party_gpu_keys/
results/ole/two_party_keys/
results/ole/two_party_keys_*/
results/secure_convert/two_party_outputs/
scripts/__pycache__/

# -- Downloaded/build-only third-party dependencies --
.deps/
extern/NFLlib/

# -- Build sources hidden by the top-level `*.txt` rule --
!src/emp_silent_bridge_build/CMakeLists.txt

# -- Regenerable live-run working directories and private party records --
results/fc/two_party_fc_work_*/
results/fc/two_party_fc_model_scale_work_*/
results/conv/two_party_conv_work_*/

results/secure_truncate/two_party_outputs/
results/fc/forward_linear_record_set_*/
results/fc/forward_linear_record_set_ledger_*/
results/**/private_inputs/
results/**/ledger/

# Defense in depth: serialized party state and consume-once claims are never
# publication evidence, even when a new runner uses an unlisted directory.
results/**/*.key
results/**/*.spfss
results/**/*.noise
results/**/*.fc
results/**/*.conv
results/**/*.convert
results/**/*.truncate
results/**/*.state
results/**/*.record
results/**/*.claim
results/**/*.bin
results/**/*.stdout
# -- Regenerable TeX intermediates --
results/reports/*.aux
results/reports/*.log
results/reports/*.out

# -- Editor / OS cruft --
*.swp
*.swo
*~
.DS_Store
Thumbs.db
